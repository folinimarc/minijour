# Website operator: set before building to offer Dropbox in cloud settings.
# Leave empty for a local-only app. See docs/deployment.md for provider setup.
# This key is public. Never include app secrets or account tokens in VITE_ variables.
VITE_DROPBOX_APP_KEY=

# Deployment path, including leading/trailing slashes. Defaults to /.
# For GitHub project Pages, use /minijour/; for a custom domain root, use /.
VITE_BASE_PATH=/
